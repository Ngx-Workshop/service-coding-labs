    "schemas": {
      "ComparatorDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "deepEqual",
              "strictEqual",
              "numberTolerance",
              "stringNormalized",
              "custom"
            ]
          },
          "tolerance": {
            "type": "number"
          },
          "normalizeWhitespace": {
            "type": "boolean"
          },
          "ignoreCase": {
            "type": "boolean"
          },
          "customComparatorId": {
            "type": "string"
          }
        },
        "required": [
          "kind"
        ]
      },
      "LabTestCaseDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "io",
              "unit"
            ]
          },
          "input": {
            "nullable": true,
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {}
              },
              {
                "type": "object",
                "additionalProperties": true
              }
            ]
          },
          "expected": {
            "nullable": true,
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {}
              },
              {
                "type": "object",
                "additionalProperties": true
              }
            ]
          },
          "comparator": {
            "$ref": "#/components/schemas/ComparatorDto"
          },
          "testCode": {
            "type": "string"
          },
          "framework": {
            "type": "string",
            "enum": [
              "jest",
              "vitest"
            ]
          }
        },
        "required": [
          "name",
          "kind"
        ]
      },
      "PublishedLabDto": {
        "type": "object",
        "properties": {
          "labId": {
            "type": "string"
          },
          "versionId": {
            "type": "string"
          },
          "versionNumber": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "intro",
              "easy",
              "medium",
              "hard"
            ]
          },
          "language": {
            "type": "string",
            "enum": [
              "javascript",
              "typescript"
            ]
          },
          "promptMarkdown": {
            "type": "string"
          },
          "hints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "starterCode": {
            "type": "string"
          },
          "sampleTests": {
            "type": "array",
            "items": {
