            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "intro",
              "easy",
              "medium",
              "hard"
            ]
          },
          "estimatedMinutes": {
            "type": "number"
          },
          "status": {
